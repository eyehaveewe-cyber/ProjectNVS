extends Node3D
## Native ArrayMesh rendering of the existing Zendelves-derived procedural art.
## Generated by tools/bake-native.mjs. No JavaScript executes in Godot.
const Wildwood = preload("res://scripts/wildwood.gd")
var bounds: float = Wildwood.BOUNDS
var expansion: Node3D

var data: Dictionary = {}
var definitions: Array = []
var colliders: Array = []
var colors: Array[Color] = []
var site_nodes: Dictionary = {}
var site_variants: Dictionary = {}
var heart_meshes: Array[ArrayMesh] = []
var heart: MeshInstance3D
var material: ShaderMaterial
var triangles_visible: int = 0

static func height_at(x: float, z: float) -> float:
	return 0.18 + sin(x * 0.12 + 0.5) * 0.16 + cos(z * 0.14 - 0.3) * 0.12 + sin((x + z) * 0.18) * 0.075

func _ready() -> void:
	var bytes := FileAccess.get_file_as_bytes("res://assets/valley.nvs.gz")
	var decoded := bytes.decompress_dynamic(64000000, FileAccess.COMPRESSION_GZIP)
	var parsed: Variant = JSON.parse_string(decoded.get_string_from_utf8())
	assert(parsed is Dictionary, "The native valley asset could not be read.")
	data = parsed
	definitions = data.definitions
	colliders = data.colliders
	for value in data.palette:
		colors.append(Color(str(value)))
	material = ShaderMaterial.new()
	var shader := Shader.new()
	shader.code = """shader_type spatial;
render_mode unshaded, cull_disabled;
uniform float rain_amount = 0.0;
uniform vec3 faun_focus = vec3(0.0,1.0,4.0);
varying vec3 world_point;
void vertex(){world_point=(MODEL_MATRIX*vec4(VERTEX,1.0)).xyz;}
void fragment(){
 vec3 ray=faun_focus-CAMERA_POSITION_WORLD;
 float t=dot(world_point-CAMERA_POSITION_WORLD,ray)/max(dot(ray,ray),0.01);
 float d=distance(world_point,CAMERA_POSITION_WORLD+ray*t);
 if(t>0.0&&t<0.96&&d<0.95&&world_point.y>faun_focus.y-0.9){
  if(fract(FRAGCOORD.x*0.5+FRAGCOORD.y*0.25)<0.72*(1.0-smoothstep(0.6,0.95,d)))discard;
 }
 ALBEDO=COLOR.rgb*mix(vec3(1.0),vec3(0.85,0.92,1.0),rain_amount);
}"""
	material.shader = shader
	_add_mesh("Valley", make_mesh(_core_geometry(data.base)))
	for site in definitions:
		var id: String = site.id
		var variants: Dictionary = {}
		for state: String in ["damaged", "healed", "full"]:
			variants[state] = make_mesh(_site_geometry(data.sites[id][state],site))
		site_variants[id] = variants
		site_nodes[id] = _add_mesh(id, variants.damaged)
	for geometry in data.hearts:
		heart_meshes.append(make_mesh(geometry))
	heart = _add_mesh("HeartTree", heart_meshes[0])
	expansion = Wildwood.new()
	add_child(expansion)
	expansion.build(material,definitions)
	colliders.append_array(expansion.colliders)
	data.erase("base")
	data.erase("sites")
	data.erase("hearts")
	data.erase("faces")

func _core_geometry(geometry: Dictionary) -> Dictionary:
	# The old valley's distant hills were scenery beyond an island boundary.
	# Replace those silhouettes with continuous country while keeping its core.
	var retained: Array = []
	for index in geometry.f:
		var face: Array = data.faces[int(index)]
		var center := Vector3((float(face[1])+float(face[4])+float(face[7]))/3.0,(float(face[2])+float(face[5])+float(face[8]))/3.0,(float(face[3])+float(face[6])+float(face[9]))/3.0)
		if maxf(absf(center.x),absf(center.z))>28.6 and center.y>-0.75:
			continue
		if Vector2(center.x,center.z).length()>30.0 and center.y>0.8:
			continue
		retained.append(index)
	return {"f":retained}

func _site_geometry(geometry: Dictionary, site: Dictionary) -> Dictionary:
	if str(site.kind)!="scorch":
		return geometry
	# Keep the ash garden's old stumps. New shoots replace the original instant
	# mature crowns, so the restoration reads as recovery still taking place.
	var retained: Array = []
	var centers: Array[Vector2] = [Vector2(float(site.x)-2.5,float(site.z)-0.2),Vector2(float(site.x)+2.3,float(site.z)+0.9)]
	for index in geometry.f:
		var face: Array = data.faces[int(index)]
		var center := Vector3((float(face[1])+float(face[4])+float(face[7]))/3.0,(float(face[2])+float(face[5])+float(face[8]))/3.0,(float(face[3])+float(face[6])+float(face[9]))/3.0)
		var remove: bool = false
		for stump: Vector2 in centers:
			if Vector2(center.x,center.z).distance_to(stump)<1.85 and center.y>height_at(stump.x,stump.y)+0.12:
				remove = true
				break
		if not remove:
			retained.append(index)
	return {"f":retained}

func _add_mesh(label: String, mesh: ArrayMesh) -> MeshInstance3D:
	var node := MeshInstance3D.new()
	node.name = label
	node.mesh = mesh
	node.material_override = material
	add_child(node)
	return node

func make_mesh(geometry: Dictionary) -> ArrayMesh:
	var vertices := PackedVector3Array()
	var tint := PackedColorArray()
	var light := Vector3(-0.45, 0.85, -0.3).normalized()
	for index in geometry.f:
		var face: Array = data.faces[int(index)]
		var a := Vector3(float(face[1]),float(face[2]),float(face[3]))
		var b := Vector3(float(face[4]),float(face[5]),float(face[6]))
		var c := Vector3(float(face[7]),float(face[8]),float(face[9]))
		var n := (b-a).cross(c-a).normalized()
		var lit: float = n.dot(light)
		var shade: float = 0.62 + 0.35 * maxf(lit, -lit * 0.65)
		var color: Color = colors[int(face[0])] * Color(shade, shade, shade)
		for point: Vector3 in [a,b,c]:
			vertices.append(point)
			tint.append(color)
	var arrays: Array = []
	arrays.resize(Mesh.ARRAY_MAX)
	arrays[Mesh.ARRAY_VERTEX] = vertices
	arrays[Mesh.ARRAY_COLOR] = tint
	var mesh := ArrayMesh.new()
	if not vertices.is_empty():
		mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	return mesh

func set_healed(ids: Array, immediate: bool = false) -> void:
	var kinds: Dictionary = {}
	for site in definitions:
		if not kinds.has(site.kind):
			kinds[site.kind] = true
		if not ids.has(site.id):
			kinds[site.kind] = false
	for site in definitions:
		var state: String = "damaged"
		if ids.has(site.id):
			state = "full" if bool(kinds[site.kind]) else "healed"
		site_nodes[site.id].mesh = site_variants[site.id][state]
	heart.mesh = heart_meshes[clampi(ids.size(), 0, 9)]
	expansion.set_healed(ids,immediate)

func is_clear(x: float, z: float) -> bool:
	for obstacle in colliders:
		if Vector2(x-float(obstacle.x),z-float(obstacle.z)).length() < float(obstacle.radius)+0.23:
			return false
	return true

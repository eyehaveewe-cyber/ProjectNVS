extends Node
## Native MBean1-derived PCM bank. Included samples are generated by this
## project from its authored reed synth, not a third-party recording pack.
var tones: Dictionary = {}
var sustain_tones: Dictionary = {}
var sustain_frequency: Dictionary = {}
var voices: Array[AudioStreamPlayer] = []
var held: Dictionary = {}
var envelopes: Dictionary = {}
var muted: bool = false
var epoch: int = 0
var restoration: float = 0.0
var clock: float = 0.0
var step: int = 0
var region: String = "THE LANTERN CLEARING"
var current_region: String = ""
var mix_bus: StringName
const MIX_GAIN: float = 0.75
const REGION_PHRASES: Dictionary = {
	"clearing":[50,57,53,60,57,53,62,57],
	"wood":[60,67,64,62,60,64,69,67],
	"marsh":[62,69,65,64,62,65,72,69],
	"orchard":[57,64,60,62,64,60,69,64],
	"outer":[48,55,60,64,62,55,57,60]
}

func _ready() -> void:
	mix_bus = StringName("NVS_Pipes_"+str(get_instance_id()))
	AudioServer.add_bus()
	AudioServer.set_bus_name(AudioServer.bus_count-1,mix_bus)
	_update_mix()
	var bytes := FileAccess.get_file_as_bytes("res://assets/pipe_bank.nvs.gz")
	var parsed: Variant = JSON.parse_string(bytes.decompress_dynamic(16000000,FileAccess.COMPRESSION_GZIP).get_string_from_utf8())
	assert(parsed is Dictionary,"The native pipe bank could not be read.")
	for key in parsed.tones:
		var stream := AudioStreamWAV.new()
		stream.format = AudioStreamWAV.FORMAT_16_BITS
		stream.mix_rate = int(parsed.sample_rate)
		stream.stereo = false
		stream.data = Marshalls.base64_to_raw(str(parsed.tones[key]))
		tones[int(key)] = stream
	for key in parsed.sustains:
		var source: Dictionary = parsed.sustains[key]
		var stream := AudioStreamWAV.new()
		stream.format = AudioStreamWAV.FORMAT_16_BITS
		stream.mix_rate = int(parsed.sample_rate)
		stream.stereo = false
		stream.data = Marshalls.base64_to_raw(str(source.data))
		stream.loop_mode = AudioStreamWAV.LOOP_FORWARD
		stream.loop_begin = 0
		stream.loop_end = int(source.frames)
		sustain_tones[int(key)] = stream
		sustain_frequency[int(key)] = float(source.frequency)

func _update_mix() -> void:
	var index: int = AudioServer.get_bus_index(mix_bus)
	if index>=0:
		# PCM peaks are below0.18. At the32 voice cap,0.75/sqrt(n)
		# preserves headroom even if every voice peak were perfectly aligned.
		AudioServer.set_bus_volume_db(index,linear_to_db(MIX_GAIN/sqrt(float(maxi(1,voices.size())))))

func _exit_tree() -> void:
	stop()
	var index: int = AudioServer.get_bus_index(mix_bus)
	if index>0:
		AudioServer.remove_bus(index)

func _voice(stream: AudioStreamWAV, gain: float, pitch_scale: float = 1.0) -> AudioStreamPlayer:
	var voice := AudioStreamPlayer.new()
	voice.stream = stream
	voice.bus = mix_bus
	voice.volume_db = linear_to_db(clampf(gain,0.001,1.0))
	voice.pitch_scale = pitch_scale
	add_child(voice)
	voices.append(voice)
	_update_mix()
	voice.finished.connect(_retire.bind(voice))
	voice.play()
	return voice

func _retire(voice: AudioStreamPlayer) -> void:
	if not is_instance_valid(voice) or not voices.has(voice):
		return
	voices.erase(voice)
	_update_mix()
	if envelopes.has(voice):
		var tween: Tween = envelopes[voice]
		if tween.is_valid(): tween.kill()
		envelopes.erase(voice)
	voice.stop()
	voice.queue_free()

func play_note(pitch: int, gain: float = 1.0) -> void:
	if muted or pitch<0 or pitch>127 or voices.size() >= 32:
		return
	var sample_pitch: int = clampi(pitch,36,96)
	if tones.has(sample_pitch):
		_voice(tones[sample_pitch],gain,pow(2.0,float(pitch-sample_pitch)/12.0))

func note_on(pitch: int, gain: float = 1.0) -> void:
	if muted or pitch<0 or pitch>127 or held.has(pitch) or voices.size()>=32:
		return
	var sample_pitch: int = clampi(pitch,36,96)
	if not sustain_tones.has(sample_pitch):
		return
	var frequency: float = 440.0*pow(2.0,float(pitch-69)/12.0)
	var voice: AudioStreamPlayer = _voice(sustain_tones[sample_pitch],0.001,frequency/float(sustain_frequency[sample_pitch]))
	held[pitch] = voice
	var tween := create_tween()
	tween.tween_property(voice,"volume_db",linear_to_db(clampf(gain,0.001,1.0)),0.035)
	envelopes[voice] = tween

func note_off(pitch: int) -> void:
	if not held.has(pitch):
		return
	var voice: AudioStreamPlayer = held[pitch]
	held.erase(pitch)
	if envelopes.has(voice):
		var attack: Tween = envelopes[voice]
		if attack.is_valid(): attack.kill()
	var release := create_tween()
	envelopes[voice] = release
	release.tween_property(voice,"volume_db",-60.0,0.16)
	release.tween_callback(_retire.bind(voice))

func release_all() -> void:
	for pitch: int in held.keys():
		note_off(pitch)

func melody(pitches: Array, beat: float = 0.47) -> void:
	var token: int = epoch
	for pitch in pitches:
		if token != epoch or muted:
			return
		play_note(int(pitch),0.7)
		await get_tree().create_timer(beat).timeout

func stop() -> void:
	epoch += 1
	clock = 0.0
	held.clear()
	for voice in voices.duplicate():
		_retire(voice)

func tick(delta: float) -> void:
	if muted:
		return
	var key: String = region_key(region)
	if key != current_region:
		current_region = key
		step = 0
		clock = 0.0
	clock += delta
	var spacing: float = 1.4-restoration*0.45
	if clock < spacing:
		return
	clock = fmod(clock,spacing)
	var phrase: Array = REGION_PHRASES[key]
	var pitch: int = int(phrase[step%8])+(12 if restoration>0.7 else 0)
	play_note(pitch,0.16)
	if step%4==0:
		play_note(38 if step%8==0 else 43,0.12)
	step += 1

static func region_key(label: String) -> String:
	var lower: String = label.to_lower()
	if "marsh" in lower or "reedwater" in lower: return "marsh"
	if "orchard" in lower or "burn" in lower: return "orchard"
	if "wood" in lower or "grove" in lower: return "wood"
	if "clearing" in lower or "lantern" in lower or "valley" in lower: return "clearing"
	return "outer"

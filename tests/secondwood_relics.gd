extends SceneTree
const State = preload("res://scripts/secondwood_state.gd")
const Layout = preload("res://scripts/secondwood_layout.gd")
var checks: Array[String] = []
var failures: Array[String] = []
func check(label: String, condition: bool) -> void:
	if condition: checks.append(label)
	else:
		failures.append(label)
		push_error(label)
func at(state: RefCounted, point: Vector2) -> void:
	state.player.x = point.x
	state.player.z = point.y
func healed_state() -> RefCounted:
	var state := State.new()
	state.inventory.assign(["vessel","spore","spindle"])
	state.healed.assign(["source","hollow","ash"])
	return state
func _initialize() -> void:
	for finished in [false,true]:
		var old := State.new()
		old.restore({"version":1,"inventory":["vessel","spore","spindle"],"healed":["source","hollow","ash"],"won":finished,"player":{"x":54,"z":-63,"yaw":1.5}})
		check("Version 1 migration retains tools, wounds and exact valid position "+str(finished),old.inventory.size()==3 and old.healed.size()==3 and old.position2()==Layout.FINAL and old.player.yaw==1.5)
		check("Old won remains independent of Artemis finale "+str(finished),old.won==finished and not old.artemis_finale_done and old.acorn_state=="absent" and not old.artemis_accepted)
		check("Old player can accept new Artemis quest "+str(finished),talk(old).type=="artemis" and old.artemis_accepted)
	var unfinished := State.new()
	unfinished.restore({"version":1,"inventory":["vessel"],"healed":["source"],"player":{"x":-15,"z":25}})
	check("Unfinished v1 preserves valid partial healing",unfinished.inventory==["vessel"] and unfinished.healed==["source"] and unfinished.position2()==Vector2(-15,25))
	var invalid := State.new()
	invalid.restore({"inventory":["lens","spool","fake"],"crossings_complete":["west-ridge-roots","garbage"],"repair_anchors":{"bad":[0,1,2]},"acorn_state":"planted","artemis_finale_done":true,"player":{"x":155,"z":155}})
	check("Malformed prerequisites cannot forge relics or finale",invalid.inventory.is_empty() and invalid.crossings_complete.is_empty() and invalid.acorn_state=="absent" and not invalid.artemis_finale_done)
	check("Invalid position falls back to authored safe floor",Layout.is_walkable(invalid.position2(),invalid.flags()))
	for first in ["lens","spool"]:
		var state := healed_state()
		for id: String in [first,"spool" if first=="lens" else "lens"]:
			at(state,Layout.ITEMS[id].position)
			check("Either branch collects "+first+" then "+id,state.collect_item(id))
		check("Relic collection is idempotent "+first,not state.collect_item("lens") and state.inventory.size()==5)
	var state := healed_state()
	at(state,Layout.LENS)
	check("Attunement cannot happen away from the spring",state.activate_relic_target("attune").type=="far")
	state.collect_item("lens")
	at(state,Layout.TARGETS["west-ridge-roots"].position)
	check("Unattuned lens names revisit requirement",state.activate_relic_target("west-ridge-roots").type=="blocked")
	at(state,Layout.SITES.source.position)
	state.activate_relic_target("attune")
	state.activate_relic_target("attune")
	check("Attunement repeats safely without consuming Vessel",state.relic_attunements==["lens"] and state.inventory.has("vessel"))
	at(state,Layout.TARGETS["west-ridge-roots"].position)
	for pitch in [26,38,50,62,74,86]:
		state.activate_relic_target("west-ridge-roots")
		state.hold_lens(0.8,[pitch])
		check("Natural D pitch class accepted at MIDI "+str(pitch),state.lens_progress>0.7)
		state.hold_lens(0.1,[])
		check("Released hold clears incomplete progress "+str(pitch),state.lens_progress==0 and state.lens_focused)
	state.hold_lens(2.0,[63])
	check("Sharp note does not open crossing",state.lens_progress==0 and state.crossings_complete.is_empty())
	state.hold_lens(2.0,[62,64])
	check("Mixed wrong chord does not open crossing",state.crossings_complete.is_empty())
	state.hold_lens(1.0,[62])
	state.hold_lens(0.6,[62],false)
	check("Pause or disabled input clears focused hold",not state.lens_focused and state.lens_progress==0)
	state.hold_lens(10,[62])
	check("Free playing away from active target has no relic effect",state.crossings_complete.is_empty())
	state.activate_relic_target("west-ridge-roots")
	var event: Dictionary = state.hold_lens(1.5,[74])
	check("Correct focused sustain opens a permanent crossing",event.type=="opened" and state.crossings_complete==["west-ridge-roots"] and not state.lens_focused)
	var snapshot: Dictionary = state.serialize()
	check("Ephemeral hold is excluded from save",not snapshot.has("lens_progress") and not snapshot.has("lens_focused") and snapshot.version==2)
	at(state,Layout.CROWN)
	check("Invalid planting preserves absent acorn",state.plant_acorn().type=="blocked" and state.acorn_state=="absent")
	at(state,Layout.SPOOL)
	state.collect_item("spool")
	at(state,Layout.TARGETS["east-root-bridge"].position)
	state.activate_relic_target("east-root-bridge")
	check("Unknown anchor is rejected",state.bind_anchor("fake",0).type=="unknown" and state.bind_anchor("east-root-bridge",9).type=="unknown")
	at(state,Layout.HUB)
	check("Far anchor binding is rejected",state.bind_anchor("east-root-bridge",0).type=="far")
	at(state,Layout.ANCHORS["east-root-bridge"][0])
	state.bind_anchor("east-root-bridge",0)
	check("Duplicate anchor does not advance repair",state.bind_anchor("east-root-bridge",0).type=="already" and state.repair_anchors["east-root-bridge"].size()==1)
	var resumed := State.new()
	resumed.restore(JSON.parse_string(JSON.stringify(state.serialize())))
	check("JSON save roundtrip preserves partial anchors",resumed.repair_anchors["east-root-bridge"]==[0])
	for index in [1,2]:
		at(resumed,Layout.ANCHORS["east-root-bridge"][index])
		resumed.bind_anchor("east-root-bridge",index)
	check("Third anchor unlocks eastern bridge",resumed.crossings_complete.has("east-root-bridge"))
	talk(resumed)
	check("Artemis awards unique acorn from actual completion facts",resumed.acorn_state=="carried")
	talk(resumed)
	check("Repeated audience does not duplicate acorn",resumed.acorn_state=="carried")
	at(resumed,Layout.CROWN)
	check("Complete prerequisites permit planting",resumed.plant_acorn().type=="planted")
	check("Planting twice is harmless and retains Spindle",resumed.plant_acorn().type=="already" and resumed.inventory.has("spindle"))
	at(resumed,Layout.ARTEMIS)
	for note: int in State.FINAL_PHRASE: resumed.play_pitch(note)
	check("Artemis song records separate finale",resumed.artemis_finale_done and not resumed.won)
	var end := State.new()
	end.restore(JSON.parse_string(JSON.stringify(resumed.serialize())))
	check("Full version 2 JSON save retains planted canopy and finale",end.artemis_finale_done and end.acorn_state=="planted" and end.flags().has("planted") and end.crossings_complete.has("east-root-bridge"))
	var report := {"status":"passed" if failures.is_empty() else "failed","checks":checks,"failures":failures,"scope":"Isolated state fixtures test commands, both relic collection orders, MIDI pitch classes, interruptions, idempotence, version 1 migration and JSON save validation. Spatial interaction commands use explicit positions. Continuous gameplay is tested separately."}
	var file := FileAccess.open("res://docs/secondwood-relic-verification.json",FileAccess.WRITE)
	file.store_string(JSON.stringify(report,"  "))
	print(JSON.stringify(report,"  "))
	quit(0 if failures.is_empty() else 1)
func talk(state: RefCounted) -> Dictionary:
	at(state,Layout.ARTEMIS)
	return state.accept_artemis_quest()
